# Self-hosted edge. Replace {$OPSCORE_PUBLIC_HOST} with the buyer domain.
# For local smoke without public DNS use: localhost

{$OPSCORE_PUBLIC_HOST:localhost} {
	encode gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
