# OpsCore local development template — no secrets.
# This file is NOT a production deployment profile.
# Provider-neutral self-hosted Production is not yet qualified; see
# docs/commercial/SELF_HOSTED_BUYER_EDITION_2026-11-24.md.
# Never set VERCEL_ENV or release-proof flags to simulate a Vercel deployment.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000

# Local SQLite is for development/evaluation only.
DATABASE_ENGINE=sqlite
SQLITE_PATH=./data/opscore.sqlite

# Optional PostgreSQL development/integration testing only.
# Production PostgreSQL requires OPSC_PG_SSL_MODE=verify-full,
# certificate verification enabled, and a least-privilege OPSC_DATABASE_URL.
# DATABASE_ENGINE=postgres
# OPSC_DATABASE_URL=
# OPSC_PG_SSL_MODE=require
# OPSC_PG_SSL_REJECT_UNAUTHORIZED=true
# OPSC_PG_POOL_MAX=8

SESSION_TTL_HOURS=24
AUTH_MODE=local
MAX_BODY_BYTES=2000000
MAX_URL_LENGTH=8192
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_MS=60000
FIREWALL_RATE_LIMIT=240
FIREWALL_RATE_WINDOW_MS=60000
FIREWALL_RATE_STATE=memory

# Production release/hold settings are intentionally not supplied here.
# OPSC_PRODUCTION_HOLD=
# OPSC_RELEASE_VERIFIED=
# OPSC_SIGNED_TENANT_CONTEXT_PRODUCTION_ENABLED=

# OIDC (optional local integration tests)
# OIDC_ISSUER=
# OIDC_AUDIENCE=

# Stripe (optional; leave unset unless a provider is separately configured and tested)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
