# OpsCore environment template — no secrets. Copy to local .env for development only.
# Production: set values in Vercel/GitLab CI project settings, never commit them.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=https://your-deployment.example.com

# PostgreSQL (preferred production engine)
DATABASE_ENGINE=postgres
DATABASE_URL=
OPSC_DATABASE_URL=
OPSC_PG_SSL_MODE=require
OPSC_PG_SSL_REJECT_UNAUTHORIZED=true
OPSC_PG_POOL_MAX=8

# Local SQLite only (development)
# DATABASE_ENGINE=sqlite
# SQLITE_PATH=./data/opscore.sqlite

SESSION_TTL_HOURS=24
AUTH_MODE=local
MAX_BODY_BYTES=2000000
MAX_URL_LENGTH=8192
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_MS=60000
FIREWALL_RATE_LIMIT=240
FIREWALL_RATE_WINDOW_MS=60000
FIREWALL_RATE_STATE=memory

# Optional production gates
OPSC_PRODUCTION_HOLD=false
OPSC_RELEASE_VERIFIED=true
OPSC_BOOTSTRAP_TOKEN=

# OIDC (optional)
# OIDC_ISSUER=
# OIDC_AUDIENCE=

# Stripe billing (optional — leave empty if not using Stripe)
# Webhook signature verification requires the endpoint secret from Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
